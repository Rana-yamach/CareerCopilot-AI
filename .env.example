# CareerCopilot AI — Ortam Değişkenleri (örnek)
# Gerçek değerleri içeren .env dosyasını asla git'e eklemeyin.

# --- Ortam ---
ENVIRONMENT=development

# --- Veritabanı (Neon PostgreSQL + pgvector) ---
# Local geliştirme: docker-compose'daki pgvector servisini kullanın.
# Prod: Neon Console > Connection Details > Pooled connection (DATABASE_URL) ve
#       Direct connection (DATABASE_URL_SYNC, Alembic için).
DATABASE_URL=postgresql+asyncpg://careercopilot:careercopilot@pgvector:5432/careercopilot
DATABASE_URL_SYNC=postgresql://careercopilot:careercopilot@pgvector:5432/careercopilot

# --- Redis (Celery broker + cache) ---
REDIS_URL=redis://redis:6379/0

# --- JWT ---
JWT_SECRET_KEY=change-this-to-a-random-64-char-hex-string-in-production
JWT_REFRESH_SECRET_KEY=change-this-to-a-different-random-64-char-hex-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Hugging Face Inference API (Inference Providers router) ---
HF_API_TOKEN=hf_xxx_replace_me
# Fine-tune model hazır olana kadar base model kullanılır (bkz. TASKS.md Genel Kurallar madde 3)
HF_MODEL_ID=mistralai/Mistral-7B-Instruct-v0.2
# router.huggingface.co bu modeli barındıran 3. parti sağlayıcıyı bilmek ister
# (ör. featherless-ai, together, novita...). HF bu eşlemeyi dinamik yönetir;
# https://huggingface.co/api/models/{model_id}?expand[]=inferenceProviderMapping
# ile doğrulanabilir.
HF_INFERENCE_PROVIDER=featherless-ai
EMBEDDING_MODEL_ID=sentence-transformers/all-MiniLM-L6-v2

# --- GitHub ---
GITHUB_API_TOKEN=ghp_xxx_replace_me

# --- Dosya Yükleme ---
MAX_UPLOAD_SIZE_MB=5
UPLOAD_DIR=/app/uploads

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Frontend (Vercel) ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME=CareerCopilot AI
